# Snakefile for Relate with branch resampling.
#
# Migrated to the shared master_params.csv convention (see repo CLAUDE.md):
#   - reads config["params_csv"] (columns: uid, vcf_file, mu, recomb_map,
#     output_dir, inference_start, inference_end)
#   - outputs land under each row's own output_dir: {output_dir}/{uid}/...
#   - only {outdir} and {uid} are path wildcards (constrained below); iteration
#     numbers are baked as f-string literals at parse time to avoid the
#     snakemake 9.14.1 wildcard-ambiguity crash documented in CLAUDE.md.
#
# Region handling: Relate has no bp-range flag, so the full VCF is converted to
# haps/sample and the haps is then filtered to [inference_start, inference_end].
configfile: f"{workflow.basedir}/config.yaml"

import csv


def to_int(val, default=0):
    try:
        return int(val)
    except Exception:
        return default

def to_float(val, default=0.0):
    try:
        return float(val)
    except Exception:
        return default

params = {}
uids = []

with open(config["params_csv"]) as f:
    for row in csv.DictReader(f):
        uid = row["uid"]
        params[uid] = row
        uids.append(uid)

MU_DEFAULT = to_float(config.get("mu", 2.35e-8), 2.35e-8)
NE = to_float(config.get("Ne", 20000), 20000)
ITER_START = to_int(config.get("iter_start", 0), 0)
ITER_END = to_int(config.get("iter_end", 0), 0)
THIN_EVERY = to_int(config.get("thin_every", 0), 0)

all_targets = [
    f"{params[uid]['output_dir']}/{uid}/{uid}.relate.sample{ITER_END}.trees"
    for uid in uids
]

wildcard_constraints:
    uid    = r"[^/]+",   # uid never crosses a directory boundary
    outdir = r".+"       # outdir can contain slashes (full path)


rule all:
    input: all_targets


# Convert the COMPLETE VCF to HAPS/SAMPLE (Shapeit format).
rule vcf_to_haps:
    input:
        vcf = lambda wc: params[wc.uid]["vcf_file"],
    output:
        haps_full = temp(f"{{outdir}}/{{uid}}/{{uid}}.full.haps"),
        sample    = f"{{outdir}}/{{uid}}/{{uid}}.sample",
    params:
        vcf_base = lambda wc: params[wc.uid]["vcf_file"].removesuffix(".vcf.gz"),
    container: config.get("singularity")
    shell:
        r"""
        mkdir -p $(dirname {output.haps_full})
        RelateFileFormats --mode ConvertFromVcf \
            --haps {output.haps_full} \
            --sample {output.sample} \
            -i {params.vcf_base}
        """


# Restrict the haps to the inference interval [inference_start, inference_end].
# Shapeit haps column 3 is the SNP base-pair position.
rule filter_haps_region:
    input:
        haps_full = f"{{outdir}}/{{uid}}/{{uid}}.full.haps",
    output:
        haps = temp(f"{{outdir}}/{{uid}}/{{uid}}.haps"),
    params:
        start = lambda wc: params[wc.uid]["inference_start"],
        end   = lambda wc: params[wc.uid]["inference_end"],
    shell:
        r"""
        awk -v s={params.start} -v e={params.end} '$3 >= s && $3 <= e' \
            {input.haps_full} > {output.haps}
        """


# Process HapMap recombination map into Relate's expected format.
rule process_hapmap_file:
    input:
        map_file = lambda wc: params[wc.uid]["recomb_map"],
    output:
        processed_map = temp(f"{{outdir}}/{{uid}}/{{uid}}.hapmap.processed.relate"),
    container: config.get("singularity")
    shell:
        r"""
        python {workflow.basedir}/scripts/process_mapfile.py \
            {input.map_file} -o {output.processed_map}
        """


# Initial Relate inference (sample0).
rule run_relate_init:
    input:
        haps     = f"{{outdir}}/{{uid}}/{{uid}}.haps",
        sample   = f"{{outdir}}/{{uid}}/{{uid}}.sample",
        map_file = f"{{outdir}}/{{uid}}/{{uid}}.hapmap.processed.relate",
    output:
        anc  = f"{{outdir}}/{{uid}}/{{uid}}.relate.sample0.anc",
        muts = f"{{outdir}}/{{uid}}/{{uid}}.relate.sample0.mut",
    params:
        mu          = lambda wc: to_float(params[wc.uid].get("mu", MU_DEFAULT), MU_DEFAULT),
        Ne          = NE,
        prefix      = lambda wc: f"{wc.uid}.relate",
        working_dir = lambda wc: f"{wc.outdir}/{wc.uid}",
    container: config.get("singularity")
    shell:
        r"""
        set -euo pipefail
        cd "{params.working_dir}"

        Relate --mode All \
          -m "{params.mu}" \
          -N "{params.Ne}" \
          --haps {input.haps} \
          --sample {input.sample} \
          --map {input.map_file} \
          -o "{params.prefix}.sample0"
        """


# MCMC branch resampling: iterate ITER_START..ITER_END, thinning heavy outputs.
rule run_relate_mcmc:
    input:
        haps     = f"{{outdir}}/{{uid}}/{{uid}}.haps",
        sample   = f"{{outdir}}/{{uid}}/{{uid}}.sample",
        anc      = f"{{outdir}}/{{uid}}/{{uid}}.relate.sample0.anc",
        muts     = f"{{outdir}}/{{uid}}/{{uid}}.relate.sample0.mut",
        map_file = f"{{outdir}}/{{uid}}/{{uid}}.hapmap.processed.relate",
    output:
        trees = f"{{outdir}}/{{uid}}/{{uid}}.relate.sample{ITER_END}.trees",
    params:
        mu          = lambda wc: to_float(params[wc.uid].get("mu", MU_DEFAULT), MU_DEFAULT),
        Ne          = NE,
        prefix      = lambda wc: f"{wc.uid}.relate",
        iter_start  = ITER_START,
        iter_end    = ITER_END,
        thin_every  = THIN_EVERY,
        working_dir = lambda wc: f"{wc.outdir}/{wc.uid}",
    container: config.get("singularity")
    shell:
        r"""
        set -euo pipefail

        cd "{params.working_dir}"

        PREFIX="{params.prefix}"
        ITER_START="{params.iter_start}"
        ITER_END="{params.iter_end}"
        MU="{params.mu}"
        NE="{params.Ne}"
        MAP="{input.map_file}"
        THIN_EVERY="{params.thin_every}"

        for i in $(seq "${{ITER_START}}" "${{ITER_END}}"); do

          /opt/relate_lib/relate_lib/bin/Convert --mode ConvertToTreeSequence \
            --compress \
            --anc "${{PREFIX}}.sample${{i}}.anc" \
            --mut "${{PREFIX}}.sample${{i}}.mut" \
            -o "${{PREFIX}}.sample${{i}}"

          RelateCoalescentRate --mode EstimatePopulationSize \
            -i "${{PREFIX}}.sample${{i}}" \
            -o "${{PREFIX}}.sample${{i}}"

          RelateMutationRate --mode Avg \
            -i "${{PREFIX}}.sample${{i}}" \
            -o "${{PREFIX}}.sample${{i}}"

          RelateCoalescentRate --mode ReEstimateBranchLengths \
            -i "${{PREFIX}}.sample${{i}}" \
            --mrate "${{PREFIX}}.sample${{i}}_avg.rate" \
            -m "${{MU}}" \
            --coal "${{PREFIX}}.sample${{i}}.coal" \
            -o "${{PREFIX}}.sample$((i+1))"

          # Remove auxiliary files every iteration
          rm -f \
            "${{PREFIX}}.sample${{i}}_avg.rate" \
            "${{PREFIX}}.sample${{i}}.coal" \
            "${{PREFIX}}.sample${{i}}.popsize" \
            "${{PREFIX}}.sample${{i}}.mutrate" \
            "${{PREFIX}}.sample${{i}}.bin"

          # Thin heavy outputs
          keep_iter="false"
          if [ "${{i}}" -eq 0 ]; then
            keep_iter="true"
          elif [ "${{THIN_EVERY}}" -gt 0 ] && [ $(( i % THIN_EVERY )) -eq 0 ]; then
            keep_iter="true"
          elif [ "${{i}}" -eq "${{ITER_END}}" ]; then
            keep_iter="true"
          elif [ "${{THIN_EVERY}}" -le 0 ]; then
            keep_iter="true"
          fi

          if [ "${{keep_iter}}" != "true" ]; then
            rm -f \
              "${{PREFIX}}.sample${{i}}.trees" \
              "${{PREFIX}}.sample${{i}}.anc" \
              "${{PREFIX}}.sample${{i}}.mut"
          fi
        done
        """
