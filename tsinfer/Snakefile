# Snakefile for tsinfer (+ tsdate) inference.
#
# CSV-driven (master_params.csv) like argweaver/singer/relate/threads. tsinfer
# uses a CONSTANT recombination rate (config: recombination_rate) rather than a
# per-region recombination map. The ancestral state is read per row from an
# ancestral FASTA (CSV columns `ancestral_fasta` + `contig`).
configfile: "config.yaml"

import csv

params = {}
uids = []
with open(config["params_csv"]) as f:
    for row in csv.DictReader(f):
        params[row["uid"]] = row
        uids.append(row["uid"])

OUTPUT_DIR  = config["output_dir"]
THREADS     = config.get("num_threads", 4)
RECOMB_RATE = config.get("recombination_rate", 1.2e-8)

wildcard_constraints:
    uid = r"[^/]+"


rule all:
    input: [f"{OUTPUT_DIR}/{uid}.tsinfer.trees" for uid in uids]


rule convert_vcf_to_zarr:
    input:
        vcf = lambda wc: params[wc.uid]["vcf_file"]
    output:
        zarr_dir = directory(f"{OUTPUT_DIR}/{{uid}}.vcz")
    params:
        outbase = lambda wc: f"{OUTPUT_DIR}/{wc.uid}"
    container: config.get("singularity")
    shell:
        """
        mkdir -p {OUTPUT_DIR}
        # vcf2zarr needs an indexed VCF (random access) -> local symlink + tabix
        ln -sf {input.vcf} {params.outbase}.in.vcf.gz
        tabix -f -p vcf {params.outbase}.in.vcf.gz
        rm -rf {params.outbase}.icf {output.zarr_dir}
        vcf2zarr explode {params.outbase}.in.vcf.gz {params.outbase}.icf
        vcf2zarr encode {params.outbase}.icf {output.zarr_dir}
        """

rule run_tsinfer:
    input:
        zarr_dir = f"{OUTPUT_DIR}/{{uid}}.vcz"
    output:
        trees = f"{OUTPUT_DIR}/{{uid}}.tsinfer.trees"
    params:
        mu          = lambda wc: params[wc.uid]["mu"],
        fasta       = lambda wc: params[wc.uid]["ancestral_fasta"],
        contig      = lambda wc: params[wc.uid]["contig"],
        recomb_rate = RECOMB_RATE,
        script      = f"{workflow.basedir}/scripts/run_tsinfer.py"
    threads: THREADS
    container: config.get("singularity")
    shell:
        """
        python {params.script} \
            --zarr {input.zarr_dir} \
            --fasta {params.fasta} \
            --chrom {params.contig} \
            --recomb-rate {params.recomb_rate} \
            --mut-rate {params.mu} \
            --output {output.trees} \
            --threads {threads}
        """
